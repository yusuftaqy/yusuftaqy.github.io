@comment{==============================================================
  CARA ISI PUBLIKASI
  ---------------------------------------------------------------
  - Tiap publikasi = satu blok yang diawali @<tipe>{<id-unik>, ... }
  - <id-unik>: bebas, tanpa spasi. Contoh: mubarak2025minerals
  - Urutan di halaman: otomatis dari tahun (terbaru di atas)
  - Field yang sering dipakai:
      title     = judul
      author    = penulis. Pisahkan banyak penulis dengan " and "
                  Format: {Nama Belakang, Nama Depan}
      journal   = nama jurnal (untuk @article)
      year      = tahun
      html      = link ke publikasi (URL penuh, misal https://...)
      pdf       = nama file PDF di assets/pdf/ ATAU URL penuh
      abbr      = label kecil di kiri (opsional, misal nama lembaga/jurnal)
      selected  = {true} kalau mau tampil di "selected publications"
  - Hapus field yang tidak dipakai. Hapus blok contoh ini kalau sudah paham.
===============================================================}

@comment{--- CONTOH 1: artikel jurnal ---}
@article{contoh-jurnal-2025,
  title   = {Judul Artikel Jurnal Anda di Sini},
  author  = {Mubarak, Yusuf Taqy and Penulis, Kedua},
  journal = {Nama Jurnal},
  year    = {2025},
  abbr    = {Jurnal},
  html    = {https://link-ke-artikel-anda.com},
  pdf     = {}
}

@comment{--- CONTOH 2: working paper / laporan ---}
@techreport{contoh-working-paper-2024,
  title       = {Judul Working Paper atau Laporan},
  author      = {Mubarak, Yusuf Taqy},
  institution = {INDEF},
  year        = {2024},
  abbr        = {INDEF},
  html        = {https://link-working-paper.com}
}

@comment{--- CONTOH 3: artikel media / opini ---}
@misc{contoh-artikel-media-2024,
  title        = {Judul Artikel Media atau Opini},
  author       = {Mubarak, Yusuf Taqy},
  howpublished = {Nama Media (misal: Kompas, Bisnis Indonesia)},
  year         = {2024},
  abbr         = {Media},
  html         = {https://link-artikel-media.com}
}
